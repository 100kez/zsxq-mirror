# 复制为 .env 后填上真实值
# 严禁把 .env 提交到 git

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false

# DeepSeek (AI 要点分析) - https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 博查 Web Search (可选,留空则 AI 追问不联网) - https://open.bochaai.com/
BOCHA_API_KEY=

# qwgua 四方聚合支付 (可选,无则不能购买会员)
QWGUA_MCH_ID=
QWGUA_MCH_KEY=
QWGUA_BASE=https://pay.pp.qwgua.com
QWGUA_CODE_WECHAT=
QWGUA_CODE_ALIPAY=
QWGUA_CODE_TEST=
QWGUA_NOTIFY_URL=https://your-domain.com/accounts/pay/notify/
QWGUA_RETURN_URL=https://your-domain.com/accounts/pay/return/

# 邮件 SMTP (用于注册邮箱验证码)
# 默认配置为阿里云邮件推送,你也可以换成其他 SMTP 服务
ALIYUN_SMTP_HOST=smtpdm.aliyun.com
ALIYUN_SMTP_PORT=465
ALIYUN_SMTP_USER=noreply@your-domain.com
ALIYUN_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=Your Site <noreply@your-domain.com>
